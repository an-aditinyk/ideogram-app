# ─────────────────────────────────────────────────────────────────────────────
# Ideogram Studio — Environment Variables
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is git-ignored and is NEVER bundled into the client.
# ─────────────────────────────────────────────────────────────────────────────

# Your Ideogram API key (required).
# Get it from https://ideogram.ai/manage-api — it is only shown ONCE at creation.
# This is read ONLY on the server (app/api/generate). It is never exposed to the browser.
IDEOGRAM_API_KEY="your_ideogram_api_key_here"

# Optional: override the Ideogram base URL (defaults to the official endpoint).
# IDEOGRAM_API_BASE_URL=https://api.ideogram.ai

# Optional: estimated USD cost per generated image, used for local credit tracking.
# Adjust to match your plan/rendering speed. Defaults to 0.08 if unset.
# This is a NEXT_PUBLIC_ var because it is only an on-device estimate (no secret).
NEXT_PUBLIC_COST_PER_IMAGE_USD=0.08

# Optional: your total purchased credit budget in USD, for the dashboard's
# "remaining" estimate. Defaults to 0 (remaining shown as "—").
NEXT_PUBLIC_CREDIT_BUDGET_USD=5.00
